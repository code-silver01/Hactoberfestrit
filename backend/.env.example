# ── Gemma 4 Inference Provider ──────────────────────────────────────────────
# API key for your inference provider (OpenRouter, SiliconFlow, etc.)
# NEVER expose this in frontend code.
GEMMA_API_KEY=your_api_key_here

# Base URL for the OpenAI-compatible API
# OpenRouter: https://openrouter.ai/api/v1
# SiliconFlow: https://api.siliconflow.cn/v1
GEMMA_BASE_URL=https://openrouter.ai/api/v1

# Model identifier (must support vision/multimodal input)
GEMMA_MODEL=google/gemma-4-12b-it

# Optional tuning
GEMMA_MAX_TOKENS=4096
GEMMA_TEMPERATURE=0.2
